# AutoFlow Studio — Environment Variables
# Copy to .env.local. No values are needed in fixture mode (APP_MODE=fixture).
# See README.md for full documentation.

# ─── App Mode ────────────────────────────────────────────────────────────────
# "fixture" (default) — all SDK calls use deterministic fixture adapters.
# "live" — uses real Supabase, Stripe, and n8n connections.
APP_MODE=fixture

# ─── Supabase (required for APP_MODE=live) ───────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=         # Server-side only — never expose to client

# ─── Stripe (required for APP_MODE=live) ─────────────────────────────────────
STRIPE_SECRET_KEY=                 # sk_test_... — never commit a real key
STRIPE_WEBHOOK_SECRET=             # whsec_... from Stripe dashboard
STRIPE_PRICE_ID_PRO=               # Stripe Price ID for Pro plan
STRIPE_PRICE_ID_ENTERPRISE=        # Stripe Price ID for Enterprise plan

# ─── n8n Webhook Integration (required for APP_MODE=live) ────────────────────
N8N_WEBHOOK_SECRET=                # HMAC-SHA256 shared secret with your n8n instance

# ─── WorkOS SSO/SCIM (Enterprise plan only, required for APP_MODE=live) ──────
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=               # e.g. https://your-domain.com/auth/sso/callback

# ─── OpenTelemetry (optional) ────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=      # e.g. https://otel.your-observability.io
OTEL_SERVICE_NAME=autoflow-studio

# ─── GrowthBook Feature Flags (optional) ─────────────────────────────────────
GROWTHBOOK_API_HOST=               # e.g. https://cdn.growthbook.io
GROWTHBOOK_CLIENT_KEY=             # Growthbook SDK client key
NEXT_PUBLIC_GROWTHBOOK_CLIENT_KEY=

# ─── Sentry Error Tracking (optional) ────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=                 # CI only — for source map upload
